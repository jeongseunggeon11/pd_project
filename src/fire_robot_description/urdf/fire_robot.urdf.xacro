<?xml version="1.0"?>
<robot name="fire_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions [m]. base_link origin lies on the ground under the wheel axle. -->
  <xacro:property name="base_x" value="0.30"/>
  <xacro:property name="base_y" value="0.24"/>
  <xacro:property name="base_z" value="0.10"/>
  <xacro:property name="base_clearance" value="0.03"/>
  <xacro:property name="base_mass" value="2.0"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_separation" value="0.28"/>
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_x" value="-0.11"/>
  <xacro:property name="lidar_x" value="0.05"/>
  <xacro:property name="lidar_z" value="0.155"/>
  <!-- Thermal camera sits on top of the LiDAR, above its scan plane -->
  <xacro:property name="thermal_x" value="0.05"/>
  <xacro:property name="thermal_z" value="0.20"/>
  <xacro:property name="thermal_hfov" value="1.0472"/>
  <xacro:property name="nozzle_x" value="0.17"/>
  <xacro:property name="nozzle_z" value="0.11"/>

  <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- Dummy root without inertia (KDL does not support an inertial root link) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_clearance + base_z/2}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_clearance + base_z/2}"/>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_clearance + base_z/2}"/>
      <mass value="${base_mass}"/>
      <inertia ixx="${base_mass*(base_y*base_y + base_z*base_z)/12}" ixy="0" ixz="0"
               iyy="${base_mass*(base_x*base_x + base_z*base_z)/12}" iyz="0"
               izz="${base_mass*(base_x*base_x + base_y*base_y)/12}"/>
    </inertial>
  </link>

  <!-- Drive wheels -->
  <xacro:macro name="wheel" params="side y_sign">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}" ixy="0" ixz="0"
                 iyy="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}" iyz="0"
                 izz="${wheel_mass*wheel_radius*wheel_radius/2}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_sign*wheel_separation/2} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left" y_sign="1"/>
  <xacro:wheel side="right" y_sign="-1"/>

  <!-- Passive casters (frictionless spheres), front and rear: the wheels sit at the
       center of mass, so a single caster lets the base tip forward when braking -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} 0 ${caster_radius}"/>
    </joint>
    <gazebo reference="${name}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="caster" x="${caster_x}"/>
  <xacro:caster name="front_caster" x="${-caster_x}"/>

  <!-- 2D LiDAR -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>/scan</topic>
      <!-- 5 Hz / 180 beams: enough for Nav2 + fire ranging; lighter GPU load on Orin -->
      <update_rate>5</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.10669</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Thermal camera (looks along +x of thermal_link) -->
  <link name="thermal_link">
    <visual>
      <geometry><box size="0.04 0.06 0.05"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="thermal_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thermal_link"/>
    <origin xyz="${thermal_x} 0 ${thermal_z}"/>
  </joint>

  <gazebo reference="thermal_link">
    <sensor name="thermal_camera" type="thermal">
      <gz_frame_id>thermal_link</gz_frame_id>
      <topic>/thermal/image</topic>
      <!-- ~10 Hz 내외 (AGENTS.md); 5 Hz keeps confirm_frames=3 under 1 s sim time -->
      <update_rate>5</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>${thermal_hfov}</horizontal_fov>
        <image>
          <width>160</width>
          <height>120</height>
          <!-- L16: pixel value = temperature / 0.01 K -->
          <format>L16</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Extinguisher nozzle at the front, aimed forward (+x) -->
  <link name="nozzle_link">
    <visual>
      <origin rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.015" length="0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="nozzle_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nozzle_link"/>
    <origin xyz="${nozzle_x} 0 ${nozzle_z}"/>
  </joint>

  <!-- Spray particles are a separate model (fire_mission/models/spray.sdf) that the
       spray_nozzle node spawns in front of the nozzle while spraying. -->

  <!-- Gazebo systems: odom frame -> base_footprint, wheel joint states -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>10</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>

<?xml version="1.0"?>
<!-- Extinguishing powder spray. Spawned by spray_nozzle at the robot's nozzle while
     spraying and removed when spraying stops; it emits along its +x axis. -->
<sdf version="1.9">
  <model name="spray">
    <static>true</static>
    <link name="link">
      <particle_emitter name="emitter" type="point">
        <emitting>true</emitting>
        <particle_size>0.06 0.06 0.06</particle_size>
        <rate>30</rate>
        <lifetime>0.6</lifetime>
        <min_velocity>2.5</min_velocity>
        <max_velocity>3.0</max_velocity>
        <scale_rate>0.4</scale_rate>
        <color_start>1 1 1 1</color_start>
        <color_end>0.85 0.85 0.85 1</color_end>
        <particle_scatter_ratio>0.0</particle_scatter_ratio>
      </particle_emitter>
    </link>
  </model>
</sdf>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fire_mission</name>
  <version>0.1.0</version>
  <description>Fire response state machine: patrol, report, approach, align, spray, verify</description>
  <maintainer email="blueciki@gmail.com">jetson</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>fire_robot_gazebo</exec_depend>
  <exec_depend>fire_robot_navigation</exec_depend>
  <exec_depend>fire_sim</exec_depend>
  <exec_depend>fire_detection</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<!--
  Single-floor house, 10 m x 8 m, origin at the south-west outer corner.
    Living room : x 0-6,  y 0-4.5
    Kitchen     : x 6-10, y 0-4.5   (opening to living room at y 1.5-3.0)
    Bedroom 1   : x 0-4,  y 4.5-8   (door at x 2.5-3.5)
    Hall        : x 4-6,  y 4.5-8   (open to living room)
    Bedroom 2   : x 6-10, y 4.5-8   (door at x 7-8)
  All walls/furniture are box collisions of the static "house" model.
  fire_robot_navigation/scripts/world_to_map.py rasterizes them into the saved map.
-->
<sdf version="1.9">
  <world name="house">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>

    <!-- Ambient temperature seen by the thermal camera for objects without a heat signature -->
    <atmosphere type="adiabatic">
      <temperature>293</temperature>
    </atmosphere>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>14 12</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>14 12</size></plane></geometry>
          <material>
            <ambient>0.7 0.65 0.55 1</ambient>
            <diffuse>0.7 0.65 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="house">
      <static>true</static>
      <link name="link">

        <!-- ===== Outer walls (h 2.5) ===== -->
        <collision name="wall_south"><pose>5 0 1.25 0 0 0</pose><geometry><box><size>10.1 0.1 2.5</size></box></geometry></collision>
        <visual name="wall_south"><pose>5 0 1.25 0 0 0</pose><geometry><box><size>10.1 0.1 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <collision name="wall_north"><pose>5 8 1.25 0 0 0</pose><geometry><box><size>10.1 0.1 2.5</size></box></geometry></collision>
        <visual name="wall_north"><pose>5 8 1.25 0 0 0</pose><geometry><box><size>10.1 0.1 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <collision name="wall_west"><pose>0 4 1.25 0 0 0</pose><geometry><box><size>0.1 8.1 2.5</size></box></geometry></collision>
        <visual name="wall_west"><pose>0 4 1.25 0 0 0</pose><geometry><box><size>0.1 8.1 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <collision name="wall_east"><pose>10 4 1.25 0 0 0</pose><geometry><box><size>0.1 8.1 2.5</size></box></geometry></collision>
        <visual name="wall_east"><pose>10 4 1.25 0 0 0</pose><geometry><box><size>0.1 8.1 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>

        <!-- ===== Interior walls (h 2.5) ===== -->
        <!-- y = 4.5 : bedroom1 door x 2.5-3.5, hall open x 4-6, bedroom2 door x 7-8 -->
        <collision name="wall_mid_1"><pose>1.25 4.5 1.25 0 0 0</pose><geometry><box><size>2.5 0.1 2.5</size></box></geometry></collision>
        <visual name="wall_mid_1"><pose>1.25 4.5 1.25 0 0 0</pose><geometry><box><size>2.5 0.1 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <collision name="wall_mid_2"><pose>3.75 4.5 1.25 0 0 0</pose><geometry><box><size>0.5 0.1 2.5</size></box></geometry></collision>
        <visual name="wall_mid_2"><pose>3.75 4.5 1.25 0 0 0</pose><geometry><box><size>0.5 0.1 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <collision name="wall_mid_3"><pose>6.5 4.5 1.25 0 0 0</pose><geometry><box><size>1.0 0.1 2.5</size></box></geometry></collision>
        <visual name="wall_mid_3"><pose>6.5 4.5 1.25 0 0 0</pose><geometry><box><size>1.0 0.1 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <collision name="wall_mid_4"><pose>9.0 4.5 1.25 0 0 0</pose><geometry><box><size>2.0 0.1 2.5</size></box></geometry></collision>
        <visual name="wall_mid_4"><pose>9.0 4.5 1.25 0 0 0</pose><geometry><box><size>2.0 0.1 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <!-- x = 4 / x = 6 : hall side walls -->
        <collision name="wall_hall_w"><pose>4 6.25 1.25 0 0 0</pose><geometry><box><size>0.1 3.5 2.5</size></box></geometry></collision>
        <visual name="wall_hall_w"><pose>4 6.25 1.25 0 0 0</pose><geometry><box><size>0.1 3.5 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <collision name="wall_hall_e"><pose>6 6.25 1.25 0 0 0</pose><geometry><box><size>0.1 3.5 2.5</size></box></geometry></collision>
        <visual name="wall_hall_e"><pose>6 6.25 1.25 0 0 0</pose><geometry><box><size>0.1 3.5 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <!-- x = 6 : living / kitchen, opening y 1.5-3.0 -->
        <collision name="wall_kitchen_s"><pose>6 0.75 1.25 0 0 0</pose><geometry><box><size>0.1 1.5 2.5</size></box></geometry></collision>
        <visual name="wall_kitchen_s"><pose>6 0.75 1.25 0 0 0</pose><geometry><box><size>0.1 1.5 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>
        <collision name="wall_kitchen_n"><pose>6 3.75 1.25 0 0 0</pose><geometry><box><size>0.1 1.5 2.5</size></box></geometry></collision>
        <visual name="wall_kitchen_n"><pose>6 3.75 1.25 0 0 0</pose><geometry><box><size>0.1 1.5 2.5</size></box></geometry><material><diffuse>0.9 0.9 0.88 1</diffuse><ambient>0.9 0.9 0.88 1</ambient></material></visual>

        <!-- ===== Furniture ===== -->
        <!-- Living room -->
        <collision name="sofa"><pose>2.0 0.5 0.4 0 0 0</pose><geometry><box><size>2.0 0.8 0.8</size></box></geometry></collision>
        <visual name="sofa"><pose>2.0 0.5 0.4 0 0 0</pose><geometry><box><size>2.0 0.8 0.8</size></box></geometry><material><diffuse>0.3 0.35 0.5 1</diffuse><ambient>0.3 0.35 0.5 1</ambient></material></visual>
        <collision name="coffee_table"><pose>2.0 1.9 0.225 0 0 0</pose><geometry><box><size>1.0 0.6 0.45</size></box></geometry></collision>
        <visual name="coffee_table"><pose>2.0 1.9 0.225 0 0 0</pose><geometry><box><size>1.0 0.6 0.45</size></box></geometry><material><diffuse>0.5 0.35 0.2 1</diffuse><ambient>0.5 0.35 0.2 1</ambient></material></visual>
        <collision name="tv_stand"><pose>1.3 4.2 0.25 0 0 0</pose><geometry><box><size>1.4 0.4 0.5</size></box></geometry></collision>
        <visual name="tv_stand"><pose>1.3 4.2 0.25 0 0 0</pose><geometry><box><size>1.4 0.4 0.5</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <!-- Kitchen -->
        <collision name="counter"><pose>9.675 1.525 0.45 0 0 0</pose><geometry><box><size>0.55 2.95 0.9</size></box></geometry></collision>
        <visual name="counter"><pose>9.675 1.525 0.45 0 0 0</pose><geometry><box><size>0.55 2.95 0.9</size></box></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse><ambient>0.85 0.85 0.85 1</ambient></material></visual>
        <collision name="dining_table"><pose>7.9 2.3 0.375 0 0 0</pose><geometry><box><size>1.2 1.0 0.75</size></box></geometry></collision>
        <visual name="dining_table"><pose>7.9 2.3 0.375 0 0 0</pose><geometry><box><size>1.2 1.0 0.75</size></box></geometry><material><diffuse>0.5 0.35 0.2 1</diffuse><ambient>0.5 0.35 0.2 1</ambient></material></visual>
        <!-- Bedroom 1 -->
        <collision name="bed_1"><pose>1.025 6.975 0.25 0 0 0</pose><geometry><box><size>1.95 1.95 0.5</size></box></geometry></collision>
        <visual name="bed_1"><pose>1.025 6.975 0.25 0 0 0</pose><geometry><box><size>1.95 1.95 0.5</size></box></geometry><material><diffuse>0.6 0.7 0.6 1</diffuse><ambient>0.6 0.7 0.6 1</ambient></material></visual>
        <collision name="desk_1"><pose>3.625 7.575 0.375 0 0 0</pose><geometry><box><size>0.65 0.75 0.75</size></box></geometry></collision>
        <visual name="desk_1"><pose>3.625 7.575 0.375 0 0 0</pose><geometry><box><size>0.65 0.75 0.75</size></box></geometry><material><diffuse>0.5 0.35 0.2 1</diffuse><ambient>0.5 0.35 0.2 1</ambient></material></visual>
        <!-- Hall -->
        <collision name="shoe_cabinet"><pose>4.25 7.475 0.5 0 0 0</pose><geometry><box><size>0.4 0.95 1.0</size></box></geometry></collision>
        <visual name="shoe_cabinet"><pose>4.25 7.475 0.5 0 0 0</pose><geometry><box><size>0.4 0.95 1.0</size></box></geometry><material><diffuse>0.5 0.35 0.2 1</diffuse><ambient>0.5 0.35 0.2 1</ambient></material></visual>
        <!-- Bedroom 2 -->
        <collision name="bed_2"><pose>8.975 6.975 0.25 0 0 0</pose><geometry><box><size>1.95 1.95 0.5</size></box></geometry></collision>
        <visual name="bed_2"><pose>8.975 6.975 0.25 0 0 0</pose><geometry><box><size>1.95 1.95 0.5</size></box></geometry><material><diffuse>0.7 0.6 0.6 1</diffuse><ambient>0.7 0.6 0.6 1</ambient></material></visual>
        <collision name="wardrobe_2"><pose>6.35 7.475 0.9 0 0 0</pose><geometry><box><size>0.6 0.95 1.8</size></box></geometry></collision>
        <visual name="wardrobe_2"><pose>6.35 7.475 0.9 0 0 0</pose><geometry><box><size>0.6 0.95 1.8</size></box></geometry><material><diffuse>0.5 0.35 0.2 1</diffuse><ambient>0.5 0.35 0.2 1</ambient></material></visual>

      </link>
    </model>
  </world>
</sdf>
